{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nickjlucker/abuseipdb",
  "description": "MCP server for AbuseIPDB API - Check IP reputation and abuse reports",
  "repository": {
    "url": "https://github.com/nickjlucker/mcp-abuseipdb",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mcp-abuseipdb",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "AbuseIPDB API key (free: 1000 checks/day)",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "ABUSEIPDB_API_KEY"
        }
      ]
    }
  ]
}
